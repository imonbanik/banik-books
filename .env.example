# Local development keeps API auth disabled so the static app can run without
# server credentials.
BANIK_API_REQUIRE_AUTH=false
BANIK_API_AUTH_PROVIDER=
BANIK_DEFAULT_WORKSPACE_ID=default
BANIK_STORAGE_ADAPTER=file
# Production Firebase storage:
# BANIK_STORAGE_ADAPTER=firebase
# BANIK_FIRESTORE_ROOT_COLLECTION=banikWorkspaceData
BANIK_API_RATE_LIMIT_WINDOW_MS=60000
BANIK_API_RATE_LIMIT_MAX=240

# Optional comma-separated server allow-list for hosted workspaces.
# BANIK_ALLOWED_WORKSPACE_IDS=default,client-a

# Optional role mapping for production verified users.
# BANIK_ADMIN_EMAILS=owner@example.com,admin@example.com
# BANIK_VIEWER_EMAILS=viewer@example.com

# Production Firebase Admin verification:
# 1. Install firebase-admin in the deployment package.
# 2. Provide Firebase Admin credentials through the host platform,
#    FIREBASE_SERVICE_ACCOUNT_JSON, or GOOGLE_APPLICATION_CREDENTIALS.
# 3. Enable both flags below.
# BANIK_API_REQUIRE_AUTH=true
# BANIK_API_AUTH_PROVIDER=firebase
# BANIK_STORAGE_ADAPTER=firebase

# Development-only token decoding. Do not enable in production.
# BANIK_API_TRUST_UNVERIFIED_TOKEN=false

# Company teams: keep staging and production roots separate.
# Default prefix: ${BANIK_FIRESTORE_ROOT_COLLECTION}_team
# BANIK_TEAM_COLLECTION_PREFIX=banikWorkspaceData_team
# BANIK_PUBLIC_URL=https://books.example.com
# Optional transactional mail JSON API; otherwise owners can copy the invite link.
# BANIK_INVITE_EMAIL_API_URL=https://mail.example.com/send
# BANIK_INVITE_EMAIL_API_KEY=configure-on-host
# BANIK_INVITE_EMAIL_FROM=accounts@example.com
